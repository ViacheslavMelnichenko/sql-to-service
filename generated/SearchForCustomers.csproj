<Project Sdk="Microsoft.NET.Sdk">

  <!-- Generated by the `implementer` stage for the showcase conversion
       (Website.SearchForCustomers). Minimal service project per the
       `dotnet-service-shape` skill: MongoDB.Driver, no web/DI sprawl. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AssemblyName>SearchForCustomers</AssemblyName>
    <RootNamespace>SqlToService.Generated</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MongoDB.Driver" Version="3.1.0" />
  </ItemGroup>

  <!-- The test project lives under generated/tests and compiles the service via an
       explicit <Compile Include>. Keep the SDK's **/*.cs glob from pulling it into
       this service build (it would drag in xunit and a second entry point). -->
  <ItemGroup>
    <Compile Remove="tests/**/*.cs" />
  </ItemGroup>

</Project>
