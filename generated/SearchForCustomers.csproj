<Project Sdk="Microsoft.NET.Sdk">

  <!-- Generated by the `implementer` stage for the showcase conversion
       (Website.SearchForCustomers). Minimal service project per the
       `dotnet-service-shape` skill: MongoDB.Driver, no web/DI sprawl. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AssemblyName>SearchForCustomers</AssemblyName>
    <RootNamespace>SqlToService.Generated</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MongoDB.Driver" Version="3.1.0" />
  </ItemGroup>

  <!-- Enumerate this proc's two files explicitly and disable the SDK's **/*.cs
       glob. Two reasons, both load-bearing: (1) the test project under
       generated/tests would otherwise be pulled in (xunit + a second entry point);
       (2) once a SECOND proc lives in generated/ (GetStockHoldingUpdates), the glob
       would pull ITS service and Program.cs in too — a second top-level entry point
       that does not compile. Each proc's csproj now owns exactly its own files. -->
  <PropertyGroup>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="SearchForCustomersService.cs" />
    <Compile Include="Program.cs" />
  </ItemGroup>

</Project>
