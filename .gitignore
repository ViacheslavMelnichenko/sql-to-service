# Secrets — never commit (see README "Reproduce")
.env
*.env
!.env.example

# Downloaded corpus backup — pinned by SHA in restore.sh, never committed (large,
# upstream-owned). Only the extracted procs/seed/golden are committed. See
# corpus/SOURCE.md.
corpus/_bak/
*.bak

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# .NET build output — the generated source is committed, the build is not.
[Bb]in/
[Oo]bj/

# Ukrainian working copies — every *.uk.md is a private translation, never committed
*.uk.md

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
