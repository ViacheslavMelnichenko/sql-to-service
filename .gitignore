# Secrets — never commit (see README "Reproduce")
.env
*.env
!.env.example

# Downloaded corpus backup — pinned by SHA in restore.sh, never committed (large,
# upstream-owned). Only the extracted procs/seed/golden are committed. See
# corpus/SOURCE.md.
corpus/_bak/
*.bak

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# .NET build output — the generated source is committed, the build is not.
[Bb]in/
[Oo]bj/

# Eval scaffold scratch — the dry run's output is a scaffold check, not a citable
# result (wall-times shift, model fields null by construction). Only the real,
# model-driven run-*.json / baseline.json are committed. See evals/results/README.md.
evals/results/dry-run.json

# Live-run debug capture (EVAL_DEBUG=1): raw claude / gate output per attempt,
# for diagnosing a failing run. Local scratch, may contain paths — never committed.
evals/results/debug/

# Ukrainian working copies — every *.uk.md is a private translation, never committed
*.uk.md

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
